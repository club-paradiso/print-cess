{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@print-cess/web",
  "devCommand": "pnpm dev",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true,
      "release/**": true,
      "staging": true
    }
  }
}
