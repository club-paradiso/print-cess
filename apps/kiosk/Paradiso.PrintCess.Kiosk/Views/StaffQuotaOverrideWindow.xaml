<Window x:Class="Paradiso.PrintCess.Kiosk.Views.StaffQuotaOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print-cess — 직원 승인"
        Width="560"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}"
        ShowInTaskbar="False">
    <Grid Margin="38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="무료 출력 한도를 넘었습니다" FontSize="28" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Margin="0,10,0,0" FontSize="18" TextWrapping="Wrap">
            <Run Text="실제 출력량은 " />
            <Run x:Name="PageCountText" FontWeight="Bold" />
            <Run Text="입니다. 12~50페이지는 직원 승인 후 출력할 수 있습니다." />
        </TextBlock>
        <Border Grid.Row="2" Margin="0,18,0,20" Padding="14" CornerRadius="12" Background="#FFFFF3CD">
            <TextBlock Text="결제는 필요하지 않습니다. 직원 암호를 입력하면 출력할 수 있습니다."
                       FontSize="16" TextWrapping="Wrap" />
        </Border>
        <PasswordBox x:Name="PasswordInput" Grid.Row="3" Height="56" FontSize="22" Padding="12"
                     MaxLength="128" AutomationProperties.Name="직원 암호" />
        <TextBlock x:Name="ErrorMessage" Grid.Row="4" Foreground="#FF8A3B2E" FontSize="16"
                   Margin="0,12,0,0" TextWrapping="Wrap" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="출력 취소" Width="126" Height="52" Margin="0,0,12,0" Click="OnCancel" />
            <Button Content="직원 승인" Width="126" Height="52" Background="{StaticResource BrandBrush}"
                    Foreground="White" FontWeight="SemiBold" Click="OnAuthenticate" />
        </StackPanel>
    </Grid>
</Window>
